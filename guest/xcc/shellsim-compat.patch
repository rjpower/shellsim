diff --git a/src/wcc/traverse.c b/src/wcc/traverse.c
index fad418a..2fa1035 100644
--- a/src/wcc/traverse.c
+++ b/src/wcc/traverse.c
@@ -636,0 +637,6 @@ static void traverse_goto(Stmt *stmt) {
+  if (goto_label->loop) {
+    if (is_ancestor(label->parent, stmt) == NULL)
+      parse_error(PE_NOFATAL, stmt->token, "goto into a backward label loop is unsupported");
+    return;
+  }
+
@@ -686,0 +693 @@ static void traverse_stmt(Stmt *stmt) {
+  case ST_LOOP_FOR_LABEL:
@@ -714,0 +722,34 @@ static inline int traverse_label(Stmt *stmt, Vector *stmts, int i) {
+  GotoLabel *goto_label = table_get(curfunc->label_table, stmt->token->ident);
+  bool backward = false;
+  if (goto_label != NULL) {
+    for (int k = 0; k < goto_label->gotos->len; ++k) {
+      Stmt *target = goto_label->gotos->data[k];
+      Stmt *child = is_ancestor(stmt->parent, target);
+      if (child == NULL)
+        continue;
+      for (int j = 0; j < stmts->len; ++j) {
+        if (stmts->data[j] == child && j >= i)
+          backward = true;
+      }
+    }
+  }
+  if (backward) {
+    Stmt *loop = new_stmt(ST_LOOP_FOR_LABEL, NULL);
+    loop->parent = stmt->parent;
+    loop->block_for_label.label = stmt->token->ident;
+    loop->block_for_label.stmts = new_vector();
+    stmt->label.stmt->parent = loop;
+    vec_push(loop->block_for_label.stmts, stmt->label.stmt);
+    for (int j = i + 1; j < stmts->len; ++j) {
+      Stmt *child = stmts->data[j];
+      child->parent = loop;
+      vec_push(loop->block_for_label.stmts, child);
+    }
+    while (stmts->len > i + 1)
+      vec_remove_at(stmts, i + 1);
+    stmts->data[i] = loop;
+    stmt->parent = loop;
+    goto_label->loop = true;
+    traverse_stmt(loop);
+    return i;
+  }
