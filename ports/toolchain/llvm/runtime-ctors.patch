+// Split only the explicitly opted-in canonical executable profile. Ordinary
+// static executables and independently initialized side modules are unchanged.
+void Writer::createRuntimeCtorsFunction() {
+  std::string body;
+  raw_string_ostream os(body);
+  writeUleb128(os, 1, "local groups");
+  writeUleb128(os, 2, "locals");
+  writeU8(os, WASM_TYPE_I32, "local type");
+  writeU8(os, WASM_OPCODE_I32_CONST, "flag address");
+  writeSleb128(os, ctx.sym.runtimeCtorsFlag->getVA(), "flag offset");
+  if (ctx.isPic) {
+    writeU8(os, WASM_OPCODE_GLOBAL_GET, "memory base");
+    writeUleb128(os, ctx.sym.memoryBase->getGlobalIndex(), "global index");
+    writeU8(os, WASM_OPCODE_I32_ADD, "flag address");
+  }
+  writeU8(os, WASM_OPCODE_LOCAL_SET, "flag address");
+  writeUleb128(os, 0, "local index");
+  writeU8(os, WASM_OPCODE_LOCAL_GET, "flag address");
+  writeUleb128(os, 0, "local index");
+  writeU8(os, WASM_OPCODE_I32_CONST, "expected uninitialized");
+  writeSleb128(os, 0, "value");
+  writeU8(os, WASM_OPCODE_I32_CONST, "initializing");
+  writeSleb128(os, 1, "value");
+  writeU8(os, WASM_OPCODE_ATOMICS_PREFIX, "atomic prefix");
+  writeUleb128(os, WASM_OPCODE_I32_RMW_CMPXCHG, "cmpxchg");
+  writeUleb128(os, 2, "alignment");
+  writeUleb128(os, 0, "offset");
+  writeU8(os, WASM_OPCODE_LOCAL_TEE, "previous state");
+  writeUleb128(os, 1, "local index");
+  writeU8(os, WASM_OPCODE_IF, "already started");
+  writeU8(os, WASM_TYPE_NORESULT, "block type");
+  writeU8(os, WASM_OPCODE_LOCAL_GET, "previous state");
+  writeUleb128(os, 1, "local index");
+  writeU8(os, WASM_OPCODE_I32_CONST, "complete");
+  writeSleb128(os, 2, "value");
+  writeU8(os, WASM_OPCODE_I32_NE, "incomplete");
+  writeU8(os, WASM_OPCODE_IF, "reject recursive or concurrent initialization");
+  writeU8(os, WASM_TYPE_NORESULT, "block type");
+  writeU8(os, WASM_OPCODE_UNREACHABLE, "serialized initialization violation");
+  writeU8(os, WASM_OPCODE_END, "END");
+  writeU8(os, WASM_OPCODE_RETURN, "already initialized");
+  writeU8(os, WASM_OPCODE_END, "END");
+  for (const WasmInitEntry &f : initFunctions) {
+    if (f.priority > 100)
+      continue;
+    writeU8(os, WASM_OPCODE_CALL, "CALL");
+    writeUleb128(os, f.sym->getFunctionIndex(), "function index");
+    for (size_t i = 0; i < f.sym->signature->Returns.size(); ++i)
+      writeU8(os, WASM_OPCODE_DROP, "DROP");
+  }
+  writeU8(os, WASM_OPCODE_LOCAL_GET, "flag address");
+  writeUleb128(os, 0, "local index");
+  writeU8(os, WASM_OPCODE_I32_CONST, "complete");
+  writeSleb128(os, 2, "value");
+  writeU8(os, WASM_OPCODE_ATOMICS_PREFIX, "atomic prefix");
+  writeUleb128(os, WASM_OPCODE_I32_ATOMIC_STORE, "store");
+  writeUleb128(os, 2, "alignment");
+  writeUleb128(os, 0, "offset");
+  writeU8(os, WASM_OPCODE_END, "END");
+  createFunction(ctx.sym.callRuntimeCtors, body);
+}
