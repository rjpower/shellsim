--- a/lld/wasm/Writer.cpp
+++ b/lld/wasm/Writer.cpp
@@ -1211,0 +1212 @@
+    ctx.sym.initMemory->forceExport = ctx.arg.deferSharedInit;
@@ -1252,0 +1254 @@
