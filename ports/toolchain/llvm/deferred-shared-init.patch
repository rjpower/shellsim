@@ -73,0 +74 @@
+  bool deferSharedInit;
--- a/lld/wasm/Options.td
+++ b/lld/wasm/Options.td
@@ -228,0 +229,3 @@
+
+def defer_shared_init: FF<"defer-shared-init">,
