+#[cfg(test)]
+mod tests {
+    use uv_pep508::{CanonicalMarkerValueString, MarkerEnvironment, MarkerEnvironmentBuilder};
+
+    use super::TargetTriple;
+
+    #[test]
+    fn wasi_preview_one_markers_match_shellsim_cpython() {
+        let base = MarkerEnvironment::try_from(MarkerEnvironmentBuilder {
+            implementation_name: "cpython",
+            implementation_version: "3.13.7",
+            os_name: "posix",
+            platform_machine: "x86_64",
+            platform_python_implementation: "CPython",
+            platform_release: "6.0",
+            platform_system: "Linux",
+            platform_version: "6.0",
+            python_full_version: "3.13.7",
+            python_version: "3.13",
+            sys_platform: "linux",
+        })
+        .unwrap();
+        let markers = TargetTriple::Wasm32Wasip1.markers(base);
+        assert_eq!(markers.implementation_name(), "cpython");
+        assert_eq!(markers.implementation_version().to_string(), "3.13.7");
+        assert_eq!(markers.os_name(), "posix");
+        assert_eq!(markers.platform_machine(), "wasm32");
+        assert_eq!(markers.platform_python_implementation(), "CPython");
+        assert_eq!(markers.platform_release(), "0.0.0");
+        assert_eq!(markers.platform_system(), "wasi");
+        assert_eq!(
+            markers.get_string(CanonicalMarkerValueString::PlatformVersion),
+            "0.0.0"
+        );
+        assert_eq!(markers.python_full_version().to_string(), "3.13.7");
+        assert_eq!(markers.python_version().to_string(), "3.13");
+        assert_eq!(markers.sys_platform(), "wasi");
+    }
+}
