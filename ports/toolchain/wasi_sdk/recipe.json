    "-Wl,--export-all,--export-table,--growable-table,--export=__stack_pointer,--export=__cpp_exception",
    "-Wl,--wrap=dlopen,--wrap=dlsym,--wrap=dlerror,--wrap=dlclose"
  ],
  "side_link_flags": [
    "-fPIC",
    "-nostdlib",
    "-shared",
    "-Wl,--no-entry,--unresolved-symbols=import-dynamic"
