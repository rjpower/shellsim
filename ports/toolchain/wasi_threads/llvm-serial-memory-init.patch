--- /dev/null
+++ b/lld/test/wasm/serial-memory-init.s
@@ -0,0 +1,23 @@
+# RUN: llvm-mc -filetype=obj -triple=wasm32-unknown-unknown -mattr=+atomics,+bulk-memory %s -o %t.o
+# RUN: wasm-ld --no-entry --shared-memory --features=atomics,bulk-memory,mutable-globals --max-memory=131072 --export=value %t.o -o %t.default.wasm
+# RUN: llvm-objdump -d %t.default.wasm | FileCheck %s --check-prefix=DEFAULT
+# RUN: wasm-ld --no-entry --shared-memory --serial-memory-init --features=atomics,bulk-memory,mutable-globals --max-memory=131072 --export=value %t.o -o %t.serial.wasm
+# RUN: llvm-objdump -d %t.serial.wasm | FileCheck %s --check-prefix=SERIAL
+# RUN: not wasm-ld --no-entry --serial-memory-init %t.o -o %t.invalid.wasm 2>&1 | FileCheck %s --check-prefix=ERROR
+
+# DEFAULT: memory.atomic.notify
+# DEFAULT: memory.atomic.wait32
+# SERIAL: i32.atomic.rmw.cmpxchg
+# SERIAL-NOT: memory.atomic.notify
+# SERIAL-NOT: memory.atomic.wait32
+# SERIAL: unreachable
+# SERIAL-NOT: memory.atomic.notify
+# SERIAL-NOT: memory.atomic.wait32
+# ERROR: --serial-memory-init requires --shared-memory
+
+.section .data.value,"",@
+.globl value
+.p2align 2
+value:
+.int32 17
+.size value, 4
