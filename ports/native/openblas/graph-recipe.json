  },
  "source_exports": [
    {
      "source": "LICENSE",
      "destination": "licenses/openblas.txt"
    },
    {
      "source": "lapack-netlib/LICENSE",
      "destination": "licenses/lapack.txt"
    }
  ],
  "build_scripts": [
    {
      "file": "graph_prepare.py",
      "sha256": "1814e22c61d55b282c971e64dbbf13fd50b5de7fe125b387939bb2b39102f737"
    },
