      },
      {
        "phase": "after_install",
        "file": "graph_install.py",
        "sha256": "0b5d52320129228ef73811a60bbe89a4909733ae78dacf73373505c78ae33712"
      }
    ]
  },
  "exports": {
    "headers": [
      "include/cblas.h",
      "include/openblas_config.h"
    ],
    "archives": [
      "lib/libopenblas.a"
    ],
    "shared_libraries": [
      "lib/libopenblas.so"
    ],
    "pkg_config": [
      "lib/pkgconfig/openblas.pc"
    ],
    "licenses": [
      "licenses/openblas.txt",
      "licenses/compiler-rt.txt",
      "licenses/lapack.txt"
