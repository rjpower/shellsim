{
  "kind": "native-library",
  "name": "openblas",
  "version": "0.3.31",
  "soname": "libopenblas.so",
  "source": {
    "url": "https://github.com/OpenMathLib/OpenBLAS/releases/download/v0.3.31/OpenBLAS-0.3.31.tar.gz",
    "sha256": "6dd2a63ac9d32643b7cc636eab57bf4e57d0ed1fff926dfbc5d3d97f2d2be3a6",
    "subdirectory": "OpenBLAS-0.3.31"
  },
  "compiler_support": {
    "input": "sdk.shared_library_inputs",
    "linkage": "referenced-members-only"
  },
  "linkage": "shared",
  "role": "target-library",
  "target_dependencies": [],
  "needed_libraries": [],
  "exports": {
    "headers": [
      "include/cblas.h",
      "include/openblas_config.h"
    ],
    "archives": [
      "lib/libopenblas.a"
    ],
    "shared_libraries": [
      "lib/libopenblas.so"
    ],
    "pkg_config": [
      "lib/pkgconfig/openblas.pc"
    ],
    "licenses": [
      "licenses/openblas.txt",
      "licenses/compiler-rt.txt",
      "licenses/lapack.txt"
    ]
  },
  "source_exports": [
    {
      "source": "LICENSE",
      "destination": "licenses/openblas.txt"
    },
    {
      "source": "lapack-netlib/LICENSE",
      "destination": "licenses/lapack.txt"
    }
  ],
  "tests": [
    {
      "kind": "native",
      "source": "tests/graph_smoke.c",
      "link_inputs": [
        "lib/libopenblas.a"
      ]
    },
    {
      "kind": "python",
      "script": "tests/shared_smoke.py"
    }
  ],
  "sdk": "default",
  "build_system": "plain-make",
  "helpers": [
    "native/openblas/graph_prepare.py",
    "native/openblas/graph_install.py",
    "native/openblas/source.py"
  ]
}
