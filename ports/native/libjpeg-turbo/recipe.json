{
  "kind": "native-library",
  "name": "libjpeg-turbo",
  "version": "2.1.5.1",
  "target_profile": "wasi-cpython-v1",
  "target": "wasm32-wasip1",
  "linkage": "static",
  "source": {
    "url": "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/2.1.5.1/libjpeg-turbo-2.1.5.1.tar.gz",
    "sha256": "2fdc3feb6e9deb17adec9bafa3321419aa19f8f4e5dea7bf8486844ca22207bf"
  },
  "host_tools": [
    "python-build-driver",
    "wasi-sdk-clang",
    "wasi-sdk-llvm-ar"
  ],
  "target_dependencies": [],
  "features": {
    "sample_bits": 8,
    "libjpeg_abi": 62,
    "memory_source_destination": true,
    "simd": false,
    "assembly": false,
    "threads": false,
    "arithmetic_coding": false,
    "turbojpeg": false,
    "shared": false
  },
  "transitive_link_flags": [],
  "exports": {
