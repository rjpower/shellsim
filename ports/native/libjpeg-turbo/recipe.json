    "archives": [
      "lib/libjpeg.a"
    ],
    "pkg_config": [
      "lib/pkgconfig/libjpeg.pc"
    ],
    "licenses": [
      "licenses/libjpeg-turbo.txt",
      "licenses/README.ijg"
    ]
  },
  "build_scripts": [
    {
      "file": "build.py",
      "sha256": "c1119575543f08c909166e0fa17d27cc3c40edd4688a4b7f638b14a50de7c76f"
    },
    {
      "file": "../dependencies.py",
      "sha256": "b13546aee08e3e2befee7ca09d40293c475b3db19a05ad4dfeae818247d3ab44"
    }
  ]
}
