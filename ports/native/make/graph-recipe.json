{
  "target": "wasm32-wasip1-threads",
  "target_profile": "shellsim-wasi-sdk34-cpython3137-threads-v3",
  "abi": "shellsim-wasi-sdk34-cpython3137-threads-v3",
  "build_dependencies": [
    {
      "port": "toolchain/llvm",
      "version": "23.0.0",
      "recipe": "toolchain/llvm/host-recipe.json"
    }
  ],
  "platform_dependencies": [
    {
      "port": "toolchain/wasi_threads",
      "version": "3",
      "recipe": "toolchain/wasi_threads/graph-recipe.json"
    }
  ],
  "name": "make",
  "version": "4.4.1",
  "kind": "native-tool",
  "role": "guest-tool",
  "linkage": "static",
  "source": {
    "url": "https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz",
    "sha256": "dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3",
    "subdirectory": "make-4.4.1"
  },
  "patches": [
    {
      "file": "wasi.patch",
      "sha256": "999a594b1af99474348cdf8a521c32805a8cdfc3729d82a9f8bd3aa92148c11a"
    }
  ],
  "target_dependencies": [
    {
      "port": "native/shellsim-posix",
      "version": "1"
    }
  ],
  "build_scripts": [],
  "build": {
    "adapter": "configure-make",
    "jobs": 2,
    "configure_args": [
      "--host=wasm32-wasi",
      "--build=x86_64-pc-linux-gnu",
      "--disable-nls",
      "--without-guile",
      "make_cv_synchronous_posix_spawn=yes"
    ],
    "configure_environment": {
      "ac_cv_func_sigaction": "no",
      "ac_cv_func_pselect": "no",
      "ac_cv_func_sigprocmask": "no",
      "ac_cv_func_sigsetmask": "no",
      "ac_cv_have_decl_bsd_signal": "no",
      "ac_cv_func_posix_spawnattr_setsigmask": "no",
      "CFLAGS": "-O2 -g0 -D_WASI_EMULATED_SIGNAL=1",
      "LIBS": "-lshellsim-posix -lwasi-emulated-signal",
      "LDFLAGS": "-Wl,--wrap=signal,--wrap=open,--wrap=openat"
    },
    "build_args": [
      "CFLAGS=-O2 -g0 -D_WASI_EMULATED_SIGNAL=1 -include process_abi.h -include process_port.h -include exec_port.h -include tempfile_port.h -include posix.h"
    ]
  },
  "exports": {
    "tools": [
      "bin/make"
    ],
    "licenses": [
      "share/licenses/make/COPYING"
    ]
  },
  "source_exports": [
    {
      "source": "COPYING",
      "destination": "share/licenses/make/COPYING"
    }
  ],
  "install": {
    "kind": "build-tool"
  },
  "tests": [
    {
      "kind": "shell",
      "script": "tests/graph_make.sh"
    }
  ]
}
