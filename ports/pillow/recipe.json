{
  "kind": "python-extension",
  "name": "pillow",
  "version": "12.3.0",
  "target_profile": "wasi-cpython-v1",
  "target": "wasm32-wasip1",
  "linkage": "cpython-builtin",
  "source": {
    "url": "https://files.pythonhosted.org/packages/1c/3d/bb7fca845737cf9d7dbde16ed1843984665ff2e0a518f5db43e77ec540b9/pillow-12.3.0.tar.gz",
    "sha256": "3b8182a766685eaa002637e28b4ec8d6b18819a0c71f579bf0dbaa5830297cce"
  },
  "host_tools": [
    "python-build-driver",
    "wasi-sdk-clang",
    "wasi-sdk-llvm-ar"
  ],
  "target_development": {
    "cpython": "3.13.7"
  },
  "target_dependencies": [
    {
      "port": "native/zlib",
      "version": "1.3.1"
    }
  ],
  "features": {
    "png": true,
    "jpeg": false,
    "jpeg2000": false,
    "tiff": false,
    "webp": false,
    "avif": false,
    "freetype": false,
    "lcms": false,
    "raqm": false,
    "imagequant": false,
    "xcb": false,
    "imagingmath": false,
    "imagingmorph": false
  },
  "requires_python": ">=3.10",
  "requires_dist": [
    "furo; extra == \"docs\"",
    "olefile; extra == \"docs\"",
    "sphinx>=8.2; extra == \"docs\"",
    "sphinx-autobuild; extra == \"docs\"",
    "sphinx-copybutton; extra == \"docs\"",
    "sphinx-inline-tabs; extra == \"docs\"",
    "sphinxext-opengraph; extra == \"docs\"",
    "olefile; extra == \"fpx\"",
    "olefile; extra == \"mic\"",
    "arro3-compute; extra == \"test-arrow\"",
    "arro3-core; extra == \"test-arrow\"",
    "nanoarrow; extra == \"test-arrow\"",
    "pyarrow; extra == \"test-arrow\"",
    "coverage>=7.4.2; extra == \"tests\"",
    "defusedxml; extra == \"tests\"",
    "markdown2; extra == \"tests\"",
    "olefile; extra == \"tests\"",
    "packaging; extra == \"tests\"",
    "pytest; extra == \"tests\"",
    "pytest-cov; extra == \"tests\"",
    "pytest-timeout; extra == \"tests\"",
    "pytest-xdist; extra == \"tests\"",
    "setuptools; extra == \"tests\"",
    "trove-classifiers>=2024.10.12; extra == \"tests\"",
    "defusedxml; extra == \"xmp\""
  ],
  "builtin_modules": [
    "PIL._imaging"
  ],
  "dist_info": "/usr/lib/python3.13/site-packages/pillow-12.3.0.dist-info",
  "patches": [
    {
      "file": "../numpy/cpython-qualified-builtins.patch",
      "sha256": "678994500f8deaa9fca773db3fc7e33f29022092077dc690a103240e6a8c4f25"
    }
  ],
  "build_scripts": [
    {
      "file": "build.py",
      "sha256": "7e5c64eca0eea181f32a4754b465a7c1fade371a31ccd79f6dde8fab72acb4b2"
    },
    {
      "file": "../native/dependencies.py",
      "sha256": "b13546aee08e3e2befee7ca09d40293c475b3db19a05ad4dfeae818247d3ab44"
    }
  ],
  "verify": "import zlib; from PIL import Image; assert zlib.decompress(zlib.compress(b\"round trip\")) == b\"round trip\"; image = Image.new(\"RGB\", (3, 2), (20, 40, 60)); image.save(\"/tmp/roundtrip.png\"); restored = Image.open(\"/tmp/roundtrip.png\"); assert restored.tobytes() == image.tobytes()"
}
