    "click",
    "joblib",
    "regex>=2021.8.3",
    "tqdm",
    "numpy; extra == \"machine-learning\"",
    "python-crfsuite; extra == \"machine-learning\"",
    "scikit-learn; extra == \"machine-learning\"",
    "scipy; extra == \"machine-learning\"",
    "matplotlib; extra == \"plot\"",
    "pyparsing; extra == \"tgrep\"",
    "twython; extra == \"twitter\"",
    "requests; extra == \"corenlp\"",
    "scipy; extra == \"all\"",
    "pyparsing; extra == \"all\"",
    "twython; extra == \"all\"",
    "numpy; extra == \"all\"",
    "requests; extra == \"all\"",
    "python-crfsuite; extra == \"all\"",
    "matplotlib; extra == \"all\"",
    "scikit-learn; extra == \"all\""
  ],
  "runtime_dependencies": [
    {
      "port": "python/defusedxml",
      "version": "0.7.1"
    },
    {
      "port": "python/click",
      "version": "8.5.0"
    },
    {
      "port": "python/joblib",
      "version": "1.6.0"
    },
    {
      "port": "python/regex",
      "version": "2026.9.29"
    },
    {
      "port": "python/tqdm",
      "version": "4.70.1"
    }
  ],
  "tests": [
    {
      "kind": "python",
      "script": "tests/probes/operations.py"
