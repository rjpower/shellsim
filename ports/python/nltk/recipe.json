  "sdk": "default",
  "patches": [
    {
      "file": "wasi-downloads.patch",
      "sha256": "b2c7d20f3dd934ab2e7a7e4d9bfba53ab95922928746a8f5418d843d3897e045"
    }
  ],
  "build_dependencies": [
    {
      "port": "python/setuptools",
      "version": "84.0.0"
    },
    {
      "port": "python/packaging",
      "version": "26.3"
    }
  ]
}
