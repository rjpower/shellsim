{
  "name": "cpython-stdlib-zlib",
  "version": "3.13.7",
  "kind": "native-library",
  "role": "target-library",
  "linkage": "shared",
  "source": {
    "url": "https://www.python.org/ftp/python/3.13.7/Python-3.13.7.tar.xz",
    "sha256": "5462f9099dfd30e238def83c71d91897d8caa5ff6ebc7a50f14d4802cdaaa79a",
    "subdirectory": "Python-3.13.7"
  },
  "target_dependencies": [
    {
      "port": "native/zlib",
      "version": "1.3.1"
    }
  ],
  "build": {
    "adapter": "python-extension",
    "output": "stdlib",
    "module": "zlib",
    "sources": [
      "Modules/zlibmodule.c"
    ],
    "defines": [
      "Py_BUILD_CORE_MODULE"
    ],
    "cpython_include_directories": [
      "internal"
    ],
    "include_directories": [
      "include"
    ],
    "link_inputs": [
      "lib/libz.so"
    ],
    "native_dependencies": [
      "libz.so"
    ],
    "licenses": [
      "LICENSE"
    ]
  },
  "exports": {
    "shared_libraries": [
      "lib-dynload/zlib.so"
    ],
    "licenses": [
      "licenses/LICENSE"
    ]
  },
  "needed_libraries": [
    "libz.so"
  ],
  "build_scripts": [],
  "tests": [
    {
      "kind": "python",
      "script": "tests/graph_zlib.py"
    }
  ],
  "test_limits": {
    "cpu": 10000000000,
    "memory": 2147483648,
    "disk": 268435456
  },
  "install": {
    "kind": "runtime",
    "destinations": {
      "lib-dynload/zlib.so": "/usr/lib/python3.13/lib-dynload/zlib.so"
    }
  },
  "sdk": "default"
}
