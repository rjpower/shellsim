    },
    {
      "port": "native/freetype",
      "version": "2.13.3",
      "recipe": "native/freetype/graph-recipe.json"
    }
  ],
  "runtime_dependencies": [
    {
      "port": "python/cpython-stdlib-zlib",
      "version": "3.13.7",
      "recipe": "python/cpython/stdlib-zlib-graph-recipe.json"
    }
  ],
  "build": {
