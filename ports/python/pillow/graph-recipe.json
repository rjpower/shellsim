  "source": {
    "url": "https://files.pythonhosted.org/packages/1c/3d/bb7fca845737cf9d7dbde16ed1843984665ff2e0a518f5db43e77ec540b9/pillow-12.3.0.tar.gz",
    "sha256": "3b8182a766685eaa002637e28b4ec8d6b18819a0c71f579bf0dbaa5830297cce",
    "subdirectory": "pillow-12.3.0"
  },
  "build_dependencies": [
    {
      "port": "toolchain/llvm",
      "recipe": "toolchain/llvm/host-recipe.json",
      "version": "23.0.0"
    },
    {
      "port": "python/setuptools",
      "version": "84.0.0"
    },
    {
      "port": "python/pybind11",
      "version": "3.0.4"
    },
    {
      "port": "python/packaging",
      "version": "26.3"
    }
  ],
  "target_dependencies": [
    {
      "port": "native/zlib",
      "version": "1.3.1",
      "recipe": "native/zlib/cmake-recipe.json"
    },
    {
      "port": "native/libjpeg-turbo",
      "version": "2.1.5.1",
