{
  "name": "numpy",
  "version": "2.3.5",
  "role": "target-library",
  "kind": "python-project",
  "requires_python": ">=3.11",
  "requires_dist": [],
  "linkage": "shared",
  "target_dependencies": [],
  "source": {
    "url": "https://files.pythonhosted.org/packages/76/65/21b3bc86aac7b8f2862db1e808f1ea22b028e30a225a34a5ede9bf8678f2/numpy-2.3.5.tar.gz",
    "sha256": "784db1dcdab56bf0517743e746dfb0f885fc68d948aba86eeec2cba234bdf1c0",
    "subdirectory": "numpy-2.3.5"
  },
  "patches": [
    {
      "file": "meson-threads.patch",
      "sha256": "6d33533ef5ada259b3a56fa2f2c09f6e8652f6c199ff758fad0ddbb48ab618d0",
      "inputs": {
        "numpy/_core/include/numpy/npy_cpu.h": "570f2654f9b57c698b75e2d5dd1a0166704c31703c720860c117568659032e2e",
        "numpy/_core/src/common/npy_hashtable.cpp": "a9b27073c9f44bd2bdea154adac48e846441fb458155cead13ce1433bd907f02",
        "numpy/_core/src/umath/dispatching.cpp": "4bfbc2ad942239f7ea9c89f56839272221bca7f12326eb157d5d3d3ced063de3"
      }
    }
  ],
  "build": {
    "adapter": "python-meson",
    "jobs": 8,
    "metadata": "PKG-INFO",
    "licenses": [
      "LICENSE.txt",
      "LICENSES_bundled.txt"
    ],
    "cross_properties": {
      "longdouble_format": "IEEE_QUAD_LE"
    },
    "configure_args": [
      "--buildtype=release",
      "-Dblas=none",
      "-Dlapack=none",
      "-Ddisable-threading=false",
      "-Ddisable-optimization=true",
      "-Ddisable-highway=true",
      "-Ddisable-intel-sort=true",
      "-Dcpu-baseline=none",
      "-Dcpu-dispatch=none"
    ],
    "development_exports": [
      {
        "source": "numpy/_core/include",
        "destination": "include"
      },
      {
        "source": "numpy/_core/lib",
        "destination": "lib"
      },
      {
        "source": "numpy/_core/include",
        "destination": "python/numpy/_core/include"
      },
      {
        "source": "numpy/f2py/src",
        "destination": "python/numpy/f2py/src"
      },
      {
        "source": "numpy/random/lib/libnpyrandom.a",
        "destination": "lib/libnpyrandom.a"
      }
    ]
  },
  "export_directories": {
    "headers": [
      "include",
      "python/numpy/_core/include",
      "python/numpy/f2py/src"
    ],
    "data": [
      "lib/npy-pkg-config"
    ]
  },
  "exports": {
    "archives": [
      "lib/libnpymath.a",
      "lib/libnpyrandom.a"
    ],
    "pkg_config": [
      "lib/pkgconfig/numpy.pc"
    ]
  },
  "tests": [
    {
      "kind": "python",
      "script": "tests/graph_smoke.py"
    }
  ],
  "test_limits": {
    "cpu": 100000000000,
    "memory": 4294967296,
    "disk": 402653184
  },
  "runtime_dependencies": [
    {
      "port": "python/cpython-stdlib-zlib",
      "version": "3.13.7"
    }
  ],
  "build_profile": "wasi-threads-v3"
}
