      "script": "tests/probes/anonymous.py"
    }
  ],
  "test_limits": {
    "cpu": 1000000000000,
    "memory": 8589934592,
    "disk": 1073741824
  },
  "patches": [
    {
      "file": "wasi-flush.patch",
      "sha256": "4154333c015d927031dc4aee3fed5a178c7595a388768370c75f2e4e69b281c5"
