{
  "name": "cpython-stdlib-bz2",
  "version": "3.13.7",
  "source": {
    "url": "https://www.python.org/ftp/python/3.13.7/Python-3.13.7.tar.xz",
    "sha256": "5462f9099dfd30e238def83c71d91897d8caa5ff6ebc7a50f14d4802cdaaa79a",
    "subdirectory": "Python-3.13.7"
  },
  "role": "target-library",
  "kind": "native-library",
  "linkage": "shared",
  "sdk": "default",
  "build_system": "python-extension",
  "output": "stdlib",
  "module": "_bz2",
  "target_dependencies": [
    {
      "port": "native/bzip2",
      "version": "1.0.8"
    }
  ],
  "exports": {
    "shared_libraries": [
      "lib-dynload/_bz2.so"
    ],
    "licenses": [
      "licenses/LICENSE"
    ]
  },
  "needed_libraries": [
    "libbz2.so"
  ],
  "install": {
    "kind": "runtime",
    "destinations": {
      "lib-dynload/_bz2.so": "/usr/lib/python3.13/lib-dynload/_bz2.so"
    }
  },
  "tests": [
    {
      "kind": "python",
      "script": "tests/probes/compression.py"
    }
  ],
  "test_limits": {
    "cpu": 1000000000000,
    "memory": 8589934592,
    "disk": 1073741824
  }
}
